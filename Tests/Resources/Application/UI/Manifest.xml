<App name="UITest">
    <Resources>

    </Resources>

    <Include src="./Styles.xml"></Include>

    <Styles>
        <Style name="inlined-style">
            <Property name="width" value="200px"/>
            <Property name="height" value="100px"/>
        </Style>
    </Styles>

    <Include src="./HomePage.xml"></Include>

    <Page name="inlined-page">
        <Frame>
            <Button id="inlined-1" style="button">
                <State name="hover">
                    <Property name="background-color" value="#00AA00"/>
                </State>
                <State name="active">
                    <Property name="background-color" value="#0000AA"/>
                </State>
            </Button>
        </Frame>
    </Page>
</App>